---
import Footer from '@components/globals/Footer.astro'
import Header from '@components/globals/Header.astro'
import Legal from '@components/globals/Legal.astro'
import CartSidebar from '@components/globals/cart/Cart.svelte'
import Layout from './Layout.astro'

const { seo } = Astro.props
---

<Layout {seo}>
  <Header />
  <CartSidebar client:load />
  <main>
    <slot />
  </main>
  <Footer />
  <Legal />
</Layout>
