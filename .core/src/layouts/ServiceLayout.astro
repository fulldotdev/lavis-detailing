---
import RenderBlocks from '@components/misc/RenderBlocks.astro'
import ActionLayout from '@layouts/ActionLayout.astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'services'>
}

const { data } = Astro.props.entry
---

<ActionLayout seo={data.seo}>
  <RenderBlocks blocks={data.content_blocks} />
</ActionLayout>
