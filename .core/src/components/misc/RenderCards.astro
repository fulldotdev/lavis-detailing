---
import { getEntryByPath, getRouteByEntry } from '@utils'
import getCardConfig from '@utils/getCardConfig'
import { type CollectionEntry, type ContentCollectionKey } from 'astro:content'
import merge from 'deepmerge'
import RenderCard, { type RenderCardProps } from './RenderCard.astro'

export type CardsBuilderProps = Props
export type CardsBuilderItem = Item

type Entry = CollectionEntry<ContentCollectionKey>
type Path = `${string}${Entry['collection']}/${Entry['id']}`
type Card = RenderCardProps & { _card_name?: string }

type Item = Card | Entry | Path | undefined
interface Props {
  cards?: Item[]
}

const { cards } = Astro.props

const isPath = (item: any): item is Path => typeof item === 'string'
const isEntry = (item: any): item is Entry =>
  typeof item === 'object' && 'slug' in item
const isCard = (item: any): item is Card =>
  typeof item === 'object' && !('slug' in item)

const buildCardFromEntry = (entry: Entry): RenderCardProps => ({
  href: getRouteByEntry(entry),
  ...entry.data,
})

const getCardProps = async (item: Item): Promise<Card | undefined> => {
  if (isPath(item)) item = await getEntryByPath(item)
  if (isEntry(item)) return buildCardFromEntry(item)
  else if (isCard(item)) return item
}

const getCardName = async (item: Item): Promise<string | undefined> => {
  if (isPath(item)) item = await getEntryByPath(item)
  if (isEntry(item)) return item.collection
  else if (isCard(item)) item._card_name
}
---

{
  cards?.map(async (card) => {
    const cardProps = await getCardProps(card)
    const cardName = await getCardName(card)
    const bookshopConfig = await getCardConfig(cardName)
    const merged: any = merge(cardProps, bookshopConfig)
    if (!cardProps) return
    return (
      <RenderCard
        {...cardProps}
        {...bookshopConfig}
      />
    )
  })
}
