---
import type { HTMLAttributes } from 'astro/types'
import { cva } from 'cva'
import bookshop from './link.bookshop.yml'

export type LinkProps = Props
interface Props {
  label: string | null
  href: HTMLAttributes<'a'>['href']
}

const variant = cva({
  base: 'link text-size-inherit',
})

const { href, label } = Astro.props
---

<a
  href={href}
  class={variant(bookshop.config)}
>
  {label}
</a>
