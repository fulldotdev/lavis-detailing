---
import getElementConfig from '@utils/getElementConfig'
import { cva } from 'cva'

export type WriteupProps = Props
interface Props {
  writeup?: string | null
  tagline?: string | null
  title?: string | null
  description?: string | null
}

const variant = cva({
  base: '[&_p]:mt-size2 [&_h1,&_h2,&_h3]:my-size3 [&_*]:first:mt-0 [&_*]:last:mb-0 [&_p:first-child:not(:last-child)]:(hue-brand text-size1)',
})

const { writeup, tagline, title, description } = Astro.props
const config = await getElementConfig('writeup')
---

{
  (writeup || tagline || title || description) && (
    <div class={variant(config)}>
      {tagline && <span>{tagline}</span>}
      {title && <h4>{title}</h4>}
      {description && <p>{description}</p>}
      {writeup && <Fragment set:html={writeup} />}
    </div>
  )
}
