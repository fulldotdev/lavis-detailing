---
import FeaturesCard from '@components/blocks/features/FeaturesCard.astro'
import Buttons from '@components/elements/button/Buttons.astro'
import Writeup from '@components/elements/writeup/Writeup.astro'
import Deck from '@components/wrappers/deck/Deck.astro'
import Group from '@components/wrappers/group/Group.astro'
import Section from '@components/wrappers/section/Section.astro'
import Segment from '@components/wrappers/segment/Segment.astro'
import type {
  ButtonProps,
  DeckProps,
  FeaturesCardProps,
  GroupProps,
  SectionProps,
  SegmentProps,
  WriteupProps,
} from '@types'

interface Props {
  section: SectionProps
  segment: SegmentProps
  writeup: WriteupProps
  group: GroupProps
  buttons: ButtonProps[]
  deck: DeckProps
  features: FeaturesCardProps
}

const {
  section = {},
  segment = {},
  writeup = {},
  group = {},
  buttons = [],
  deck = {},
  features = {},
} = Astro.props
---

<Section {...section}>
  <Segment {...segment}>
    <Writeup {...writeup} />
    <Group {...group}>
      <Buttons {buttons} />
    </Group>
  </Segment>
  <Deck {...deck}>
    <FeaturesCard {...features} />
  </Deck>
</Section>
