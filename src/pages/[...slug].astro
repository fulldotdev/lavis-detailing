---
import RenderBlocks from '@components/renderers/RenderBlocks.astro'
import CategoryLayout from '@modules/categories/Categories.layout.astro'
import PageLayout from '@modules/pages/Pages.layout.astro'
import PolicyLayout from '@modules/policies/Policies.layout.astro'
import PostLayout from '@modules/posts/Posts.layout.astro'
import ProductLayout from '@modules/products/Products.layout.astro'
import ServiceLayout from '@modules/services/Service.layout.astro'
import type { CollectionEntry, ContentCollectionKey } from 'astro:content'
import { getCollection } from 'astro:content'

type Entries = CollectionEntry<ContentCollectionKey>[]

export async function getStaticPaths() {
  const paths: {
    [key in ContentCollectionKey]?: string
  } = {
    pages: '',
    posts: 'posts/',
    services: 'diensten/',
    policies: 'beleid/',
    products: 'producten/',
    categories: 'categorieen/',
  }

  const keys = Object.keys(paths) as ContentCollectionKey[]
  const promises = keys.map((collection) => getCollection(collection))
  const results = await Promise.all(promises)
  const flattened = results.flat()
  const filtered = flattened.filter((result) => result && result.slug)
  const entries = filtered as Entries

  return entries.map((entry) => {
    const slug = paths[entry.collection] + entry.slug
    return {
      params: {
        slug: slug === 'index' ? undefined : slug,
      },
      props: {
        entry: entry,
      },
    }
  })
}

const { entry } = Astro.props

const layouts: {
  [key in ContentCollectionKey]?: any
} = {
  pages: PageLayout,
  posts: PostLayout,
  services: ServiceLayout,
  policies: PolicyLayout,
  products: ProductLayout,
  categories: CategoryLayout,
}

const CollectionLayout = layouts[entry.collection]
---

<CollectionLayout {entry}>
  <RenderBlocks />
</CollectionLayout>
