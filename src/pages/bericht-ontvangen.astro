---
import Writeup from '@components/elements/Writeup.astro'
import Button from '@components/elements/button/Button.astro'
import Section from '@components/wrappers/Section.astro'
import Segment from '@components/wrappers/Segment.astro'
import NavLayout from '@layouts/NavLayout.astro'
---

<NavLayout>
  <Section
    class:list={'lg:mx-auto lg:max-w-lg'}
    frame="float"
    align="center"
  >
    <Segment align="center">
      <Writeup>
        <h1>Bedankt voor je bericht!</h1>
        <p>
          We hebben je bericht ontvangen en nemen zo spoedig mogelijk contact me
          je op.
        </p>
      </Writeup>
      <Button
        importance="secondary"
        label={'Terug naar home'}
        href={'/'}
      />
    </Segment>
  </Section>
</NavLayout>
