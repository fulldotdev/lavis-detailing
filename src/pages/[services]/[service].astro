---
import Layout from '@layouts/Layout.astro'
import { getCollection } from 'astro:content'
import RenderBlocks from '../../shared/astro/RenderBlocks.astro'

export async function getStaticPaths() {
  const collection = await getCollection('services')
  if (!collection) return []
  return collection.map((entry: any) => ({
    params: {
      services: 'diensten',
      service: entry.slug,
    },
    props: {
      frontmatter: entry.data,
    },
  }))
}

const entry = Astro.props.frontmatter
---

<Layout>
  <RenderBlocks
    bookshop:live
    blocks={entry.blocks}
  />
</Layout>
