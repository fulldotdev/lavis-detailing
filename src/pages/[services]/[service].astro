---
import RenderBlocks from '@components/renderers/RenderBlocks.astro'
import Layout from '@layouts/Layout.astro'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const collection = await getCollection('services')
  if (!collection) return []
  return collection.map((entry: any) => ({
    params: {
      services: 'diensten',
      service: entry.slug,
    },
    props: {
      frontmatter: entry.data,
    },
  }))
}

const entry = Astro.props.frontmatter
---

<Layout>
  <RenderBlocks blocks={entry.blocks} />
</Layout>
