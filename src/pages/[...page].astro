---
import Hero from '@components/blocks/hero/Hero.astro'
import Layout from '@layouts/Layout.astro'
import { getCollection } from 'astro:content'
import RenderBlocks from '../shared/astro/RenderBlocks.astro'

export async function getStaticPaths() {
  const collection = await getCollection('pages')
  return collection.map((entry) => {
    return {
      params: {
        page: entry.slug === 'index' ? undefined : entry.slug,
      },
      props: {
        frontmatter: entry.data,
      },
    }
  })
}

const entry = Astro.props.frontmatter
---

<Layout>
  <RenderBlocks
    bookshop:live
    blocks={entry.blocks}
  />
  <Hero />
</Layout>
