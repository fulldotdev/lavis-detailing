---
import RenderBlocks from '@components/renderers/RenderBlocks.astro'
import Layout from '@layouts/Layout.astro'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const collection = await getCollection('pages')
  if (!collection) return []
  return collection.map((entry: any) => ({
    params: {
      page: entry.slug === 'index' ? undefined : entry.slug,
    },
    props: {
      frontmatter: entry.data,
    },
  }))
}

const data = Astro.props.frontmatter
---

<Layout>
  <RenderBlocks blocks={data.content_blocks} />
</Layout>
