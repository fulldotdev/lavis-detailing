---
import BlockBuilder from '@components/builders/BlockBuilder.astro'
import Layout from '@layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const collection = await getCollection('bookshop')
  return collection.map((entry: any) => ({
    params: {
      block: entry.id,
    },
    props: {
      frontmatter: entry.data,
    },
  }))
}

const { frontmatter } = Astro.props
const blocks = await getCollection('bookshop')
---

<Layout>
  <ol class="px-wrapper pt-wrapper gap-10px flex flex-col">
    {
      blocks.map((block) => (
        <li class="underline">
          <a href={'/blocks/' + block.id}>{block.id}</a>
        </li>
      ))
    }
  </ol>

  <BlockBuilder
    {...frontmatter.config}
    {...frontmatter.preview}
  />
</Layout>

<style is:global>
  .bottom {
    display: none;
  }
</style>
