---
import BlockBuilder from '@components/builders/BlockBuilder.astro'
import Layout from '@layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const collection = await getCollection('pages')
  const glob = import.meta.glob('/src/components/blocks/**/*.bookshop.yml')
  const blocks = await Promise.all(
    Object.keys(glob).map((path) =>
      glob[path]().then((file: any) => ({
        id: path.replace('/src/components/blocks/', '').replace('.yml', ''),
        data: file.default,
      }))
    )
  )
  return blocks.map((block: any) => {
    if (!block?.data || !block?.id) return
    return {
      params: {
        block: block.id,
      },
      props: {
        frontmatter: block.data,
      },
    }
  })
}

const { frontmatter } = Astro.props
---

<Layout>
  <BlockBuilder
    {...frontmatter.config}
    {...frontmatter.preview}
  />
</Layout>

<style is:global>
  .bottom {
    display: none;
  }
</style>
