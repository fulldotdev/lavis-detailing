---
import RenderBlock from '@components/renderers/RenderBlock.astro'
import Layout from '@layouts/Layout.astro'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const collection = await getCollection('blocks')
  return collection.map((entry: any) => ({
    params: {
      block: entry.id,
    },
    props: {
      frontmatter: entry.data,
    },
  }))
}

const { frontmatter } = Astro.props
---

<Layout>
  <div></div>
  <RenderBlock
    {...frontmatter.config}
    {...frontmatter.preview}
  />
</Layout>

<style is:global>
  .bottom {
    display: none;
  }
</style>
