---
import Price from '@components/elements/Price.astro'
import GalleryScroll from '@components/elements/gallery/GalleryScroll.svelte'
import Image from '@components/elements/image/Image.astro'
import CartUpdateButton from '@components/globals/cart/CartUpdateButton.svelte'
import RenderCards from '@components/renderers/RenderCards.astro'
import Deck from '@components/wrappers/Deck.astro'
import Prose from '@components/wrappers/Prose.astro'
import Section from '@components/wrappers/Section.astro'
import Segment from '@components/wrappers/Segment.astro'
import Writeup from '@components/wrappers/Writeup.astro'
import LayoutNav from '@layouts/LayoutNav.astro'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const collection = await getCollection('products')

  if (!collection) return []
  return collection.map((entry: any) => ({
    params: {
      products: 'producten',
      product: entry.slug,
    },
    props: {
      frontmatter: entry.data,
    },
  }))
}

const collection = await getCollection('products')
const data = Astro.props.frontmatter
---

<CartUpdateButton
  data={data}
  client:only
/>
<LayoutNav>
  <Section
    layout="row"
    y="start"
  >
    <GalleryScroll class="col-span-3">
      {data.images?.map((image: any) => <Image {...image} />)}
    </GalleryScroll>
    <Segment>
      <Writeup>
        <h1 class="heading-primary">{data.title}</h1>
        <p class="text">{data.description}</p>
      </Writeup>
      <Price
        class="size-large text-size2 text-hue12"
        price={data.price}
      />
      <CartUpdateButton
        data={data}
        client:load
      />
    </Segment>
  </Section>
  <!-- <Section layout="row">
    <Prose set:html={data.render()} />
  </Section> -->
  <Section
    layout="col"
    size="medium"
  >
    <h2 class="heading">Meer producten</h2>
    <Deck
      layout="carousel"
      size="medium"
    >
      <RenderCards items={collection} />
    </Deck>
  </Section>
</LayoutNav>
