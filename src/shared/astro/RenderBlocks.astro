---
const { blocks } = Astro.props
const components: any = {}
const componentImports = import.meta.glob('../../components/**/*.astro', {
  eager: true,
})

const toCamelCase = (s: string) => s.charAt(0).toLowerCase() + s.slice(1)
const toPascalCase = (s: string) => s.charAt(0).toUpperCase() + s.slice(1)

Object.entries(componentImports).forEach(([path, object]: any) => {
  const parts: string[] = path
    .replace('../../components/', '')
    .split('.')[0]
    .split('/')
  const camelParts = parts.map((part) => toCamelCase(part))
  const partsAreEqual: boolean =
    camelParts[camelParts.length - 1] === camelParts[camelParts.length - 2]
  if (partsAreEqual) camelParts.pop()
  let bookshopName = camelParts.join('/')
  const pascalBookshopName = toPascalCase(bookshopName)
  components[pascalBookshopName] = object.default
})
---

<main>
  {
    blocks.map((block: any) => {
      const Component = components[block._bookshop_name]
      return <Component {...block} />
    })
  }
</main>
