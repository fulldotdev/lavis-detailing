---
const { blocks } = Astro.props
const components: any = {}
const componentImports = import.meta.glob(
  '../../components/blocks/**/*.astro',
  {
    eager: true,
  }
)

const toPascalCase = (s: string) => s.charAt(0).toUpperCase() + s.slice(1)

Object.entries(componentImports).forEach(([path, object]: any) => {
  const fileName = path.split('/').pop()
  const componentName = fileName.split('.')[0]
  components[componentName] = object.default
})
---

<main>
  {
    blocks?.map((block: any) => {
      const pascalBookshopName = toPascalCase(block._bookshop_name)
      const Component = components[pascalBookshopName]
      if (!Component) {
        console.log(`No component found for ${pascalBookshopName}`)
        return null
      }
      return <Component {...block} />
    })
  }
</main>
