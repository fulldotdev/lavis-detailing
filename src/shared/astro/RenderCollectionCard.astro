---
import Buttons from '@components/elements/button/Buttons.astro'
import Image from '@components/elements/image/Image.astro'
import Rating from '@components/elements/rating/Rating.astro'
import Writeup from '@components/elements/writeup/Writeup.astro'
import Card from '@components/wrappers/Card.astro'
import Group from '@components/wrappers/Group.astro'
import Segment from '@components/wrappers/Segment.astro'
import { getEntry, type CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<
    | 'brands'
    | 'categories'
    | 'employees'
    | 'posts'
    | 'products'
    | 'reviews'
    | 'services'
  >
}

const { entry } = Astro.props
const components = await getEntry('data', 'components')
const settings = components.data.cards[entry.collection]
const merged = { ...entry.data, ...settings }
const {
  card,
  image,
  rating,
  segment,
  writeup,
  title,
  group,
  description,
  tagline,
  buttons,
} = merged

const hrefMap = {
  brands: 'merken',
  categories: 'categorieen',
  employees: 'werknemers',
  posts: 'posts',
  products: 'producten',
  reviews: 'reviews',
  services: 'diensten',
}
---

<Card
  href={`/${hrefMap[entry.collection]}/${entry.slug}`}
  {...card}
>
  <Image {...image} />
  <Rating {...rating} />
  <Segment {...segment}>
    <Writeup {...writeup}>
      {tagline && <span>{tagline}</span>}
      {title && <h4>{title}</h4>}
      {description && <p>{description}</p>}
    </Writeup>
    <Group {...group}>
      <Buttons {buttons} />
    </Group>
  </Segment>
</Card>
