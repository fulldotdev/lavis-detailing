---
import type { HTMLAttributes } from 'astro/types'

interface Props {
  title: HTMLAttributes<'input'>['value']
  key: HTMLAttributes<'input'>['value']
  action: HTMLAttributes<'form'>['action']
}

const { title, key, action } = Astro.props
---

{
  Astro.slots.has('default') && (
    <form action={action}>
      <slot />
      <input
        type="hidden"
        name="_subject"
        value={title}
      />
      <input
        type="hidden"
        name="inbox_key"
        value={key}
      />
      <input
        type="text"
        name="_gotcha"
        style="display: none;"
      />
    </form>
  )
}
 ```
