---
import { cva, type VariantProps } from 'cva'

export type ProseProps = Props
type Props = VariantProps<typeof variant>

const variant = cva({
  base: 'prose w-full',
})

const slot = await Astro.slots.render('default')
---

{
  slot?.trim().length > 0 && (
    <div class={variant(Astro.props)}>
      <slot />
    </div>
  )
}
