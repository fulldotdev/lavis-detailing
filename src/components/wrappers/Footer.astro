---
import type { HTMLAttributes, VariantProps } from '@types'
import { hue, scheme, size } from '@variants'
import { cva } from 'cva'

interface Props
  extends VariantProps<typeof variant>,
    HTMLAttributes<'footer'> {}

const variant = cva({
  base: 'area-block grid gap-size5 lg:grid-flow-col lg:auto-cols-fr size-small border-hue6 border-t relative z-20 justify-between',
  variants: {
    frame: {
      fill: 'px-wrapper py-size6',
      float: 'mx-wrapper py-size6',
      panel: 'mx-wrapper my-size6',
    },
    look: {
      ghost: 'bg-transparent',
      soft: 'bg-hue2',
      surface: 'bg-hue2 border border-hue6',
      outline: 'bg-transparent border border-hue6 ',
      solid:
        'bg-hue9 !text-hue-fg [&_*]:!text-hue-fg [&_.button]:(!bg-hue-fg !text-hue9)',
    },
    size: size,
    scheme: scheme,
    hue: hue,
  },
  defaultVariants: {
    frame: 'fill',
    look: 'ghost',
    size: 'medium',
  },
})
---

<footer
  class={variant(Astro.props)}
  {...Astro.props}
>
  <slot />
</footer>
