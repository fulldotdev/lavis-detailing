---
import type { VariantProps } from '@types'
import { size } from '@variants'
import { cva } from 'cva'

export type SegmentProps = Props
type Props = VariantProps<typeof variant>

const variant = cva({
  base: 'segment gap-x-size6 gap-y-size4 relative z-10',
  variants: {
    direction: {
      col: 'grid',
      row: 'grid lg:grid-flow-col gap-x-size6 ',
    },
    x: {
      start: 'justify-start justify-items-start',
      center: 'justify-center justify-items-center text-center',
      between: 'justify-between',
    },
    y: {
      start: 'items-start',
      center: 'items-center',
      end: 'items-end',
    },
    size: size,
  },
  defaultVariants: {
    direction: 'col',
    x: 'start',
    y: 'start',
  },
})

const slot = await Astro.slots.render('default')
---

{
  slot?.length > 4 && (
    <div class={variant(Astro.props)}>
      <slot />
    </div>
  )
}
