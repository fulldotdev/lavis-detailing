---
import type { VariantProps } from '@types'
import { size } from '@variants'
import { cva } from 'cva'

export type ListProps = Props
type Props = VariantProps<typeof variant>

const variant = cva({
  base: 'gap-y-size4 gap-x-size5',
  variants: {
    layout: {
      col: 'grid',
      row: 'flex',
    },
    x: {
      start: 'justify-start',
      center: 'justify-center',
      end: 'justify-end',
      stretch: 'justify-stretch',
    },
    y: {
      start: 'items-start',
      center: 'items-center',
      end: 'items-end',
    },
    size: size,
  },
  defaultVariants: {
    layout: 'col',
    x: 'start',
    y: 'start',
  },
})
---

{
  Astro.slots.has('default') && (
    <ul class={variant(Astro.props)}>
      <slot />
    </ul>
  )
}
