---
import type { VariantProps } from '@types'
import { size } from '@variants'
import { cva } from 'cva'

export type GroupProps = Props
type Props = VariantProps<typeof variant>

const variant = cva({
  base: 'gap-x-size3 gap-y-size2 justify-stretch',
  variants: {
    layout: {
      row: 'flex',
      col: 'flex flex-col',
    },
    size: size,
  },
  defaultVariants: {
    layout: 'row',
  },
})

const slot = await Astro.slots.render('default')
---

{
  slot?.length > 4 && (
    <div class={variant(Astro.props)}>
      <slot />
    </div>
  )
}
