---
import type { ButtonProps } from '@components/elements/button/Button.astro'
import ButtonGroup from '@components/elements/button/ButtonGroup.astro'
import Image, { type ImageProps } from '@components/elements/image/Image.astro'
import Rating from '@components/elements/rating/Rating.astro'
import Writeup from '@components/elements/writeup/Writeup.astro'
import Card, { type CardProps } from '@components/wrappers/Card.astro'
import type { GroupProps } from '@components/wrappers/Group.astro'
import Segment, { type SegmentProps } from '@components/wrappers/Segment.astro'
import type { HTMLAttributes } from 'astro/types'

export type RenderCardProps = Props
interface Props {
  href?: HTMLAttributes<'a'>['href']
  card?: CardProps
  image?: ImageProps
  segment?: SegmentProps
  rating?: number | null
  writeup?: string | null
  title?: string | null
  tagline?: string | null
  description?: string | null
  group?: GroupProps
  buttons?: ButtonProps[]
}

const {
  href,
  card,
  image,
  segment,
  rating,
  writeup,
  title,
  description,
  tagline,
  group,
  buttons,
} = Astro.props
---

<Card
  {href}
  {...card}
>
  <Image {...image} />
  <Segment {...segment}>
    <Rating {rating} />
    <Writeup
      {writeup}
      {tagline}
      {title}
      {description}
    />
    <ButtonGroup
      {buttons}
      {...group}
    />
  </Segment>
</Card>
