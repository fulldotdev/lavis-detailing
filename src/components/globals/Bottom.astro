---
import { unslugify } from '@utils'
import { getCollection, getEntry } from 'astro:content'
const company = await getEntry('data', 'company')
const policies = await getCollection('policies')
---

<div
  class="mx-wrapper py-size4 size-small mode-compact flex flex-wrap justify-between"
>
  <p class="text-size1">
    © {new Date().getFullYear()}&nbsp;{company.data.company}. Alle rechten
    voorbehouden.
  </p>
  <p class="text-size1 gap-x-size2 flex flex-wrap">
    {company.data.kvk && `Kvk. ${company.data.kvk}`}
    {
      policies.map((policy) => (
        <>
          <span>|</span>
          <a
            class="link size-small text-size1 capitalize"
            href={'/beleid/' + policy.slug}
          >
            {unslugify(policy.slug)}
          </a>
        </>
      ))
    }
  </p>
</div>
