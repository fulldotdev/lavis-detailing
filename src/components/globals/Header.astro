---
import Logo from '@components/elements/Logo.astro'
import Buttons from '@components/elements/button/Buttons.astro'
import Links from '@components/elements/link/Links.astro'
import CartIcon from '@components/globals/cart/CartIcon.svelte'
import Segment from '@components/wrappers/Segment.astro'
import { getGlobalSettings } from '@utils'
import { hue, scheme, size } from '@variants'
import { getEntry } from 'astro:content'
import { cva } from 'cva'

const header = await getEntry('data', 'header')
const settings = await getGlobalSettings('header')

const variant = cva({
  base: 'header mode-compact size-medium gap-size5 z-80 flex items-center !sticky top-0 justify-between backdrop-blur-3xl',
  variants: {
    frame: {
      fill: 'px-wrapper py-size2 border-t-0 border-l-0 border-r-0',
      float: 'mx-wrapper py-size2 border-b border-t-0 border-l-0 border-r-0',
      panel: 'mx-wrapper my-size2 p-size3',
    },
    look: {
      solid: 'bg-hue9 !text-hue-fg',
      soft: 'bg-hue2',
      surface: 'bg-hue2 border border-hue6',
      outline: 'border border-hue6',
    },
    size: size,
    scheme: scheme,
    hue: hue,
  },
  defaultVariants: {
    frame: 'fill',
    size: 'medium',
  },
})
---

<header class={variant(settings.header)}>
  <Logo />
  <Links
    layout="row"
    links={header.data.link}
  />
  <Buttons
    layout="row"
    buttons={header.data.buttons}
  />
  <CartIcon client:load />
  <label
    class="w-1.4em h-1.4em flex cursor-pointer lg:hidden"
    for="header-toggle"
  >
    <i class="icon:menu peer-checked:icon:x h-full w-full"></i>
  </label>
  <input
    id="header-toggle"
    class="peer hidden"
    type="checkbox"
  />
  <Segment
    class:list="py-size4 z-90 bg-hue1 border-hue6 absolute left-0 right-0 top-full !hidden flex-col items-center border-y text-center backdrop-blur-lg peer-checked:max-lg:!flex"
  >
    <Links
      layout="col"
      align="center"
      links={header.data.link}
    />
    <Buttons
      layout="col"
      buttons={header.data.buttons}
    />
  </Segment>
</header>
