---
import Logo from '@components/elements/Logo.astro'
import Buttons from '@components/elements/button/ButtonGroup.astro'
import Links from '@components/elements/link/Links.astro'
import CartIcon from '@components/globals/cart/CartIcon.svelte'
import Group from '@components/wrappers/Group.astro'
import Segment from '@components/wrappers/Segment.astro'
import { hue, scheme, size } from '@variants'
import { getEntry } from 'astro:content'
import { cva } from 'cva'

const variant = cva({
  base: 'header bg-hue1 mode-compact size-medium gap-size6 z-80 flex items-center top-0 justify-between',
  variants: {
    frame: {
      fill: 'px-wrapper py-size3 border-t-0 border-l-0 border-r-0',
      float: 'mx-wrapper py-size3 border-b border-t-0 border-l-0 border-r-0',
      panel: 'mx-wrapper my-size3 p-size3',
    },
    look: {
      solid: 'bg-hue9 !text-hue-fg',
      soft: 'bg-hue2',
      surface: 'bg-hue2 border border-hue6',
      outline: 'border border-hue6',
      glass: 'backdrop-blur-3xl bg-black/25',
    },
    position: {
      sticky: 'sticky top-0',
      fixed: 'fixed top-0',
      absolute: 'absolute top-0',
      relative: 'relative',
    },
    size: size,
    scheme: scheme,
    hue: hue,
  },
  defaultVariants: {
    frame: 'fill',
    size: 'medium',
    position: 'relative',
  },
})

const header = await getEntry('globals', 'header').then(({ data }) => data)
const globals = await getEntry('settings', 'globals')
const config = globals.data.header
---

{
  header && (
    <>
      <header class={variant(config)}>
        <Logo class:list="mr-auto" />
        <Links
          class:list="max-lg:hidden"
          layout="row"
          links={header.links}
        />
        <Buttons
          layout="row"
          buttons={header.buttons}
        />
        <CartIcon client:load />
        <label
          class="button look-soft flex cursor-pointer lg:hidden"
          for="header-toggle"
        >
          <i class="icon:menu-2 peer-checked:icon:x text-size2 h-1.4em w-1.4em block" />
        </label>
        <Group layout="row" />
        <input
          id="header-toggle"
          class="peer hidden"
          type="checkbox"
        />
        <Segment class:list="py-size6 z-90 bg-hue1 border-hue6 !absolute left-0 right-0 top-full !hidden flex-col items-center border-y text-center backdrop-blur-lg peer-checked:max-lg:!flex">
          <Links
            layout="col"
            align="center"
            links={header.links}
          />
          <Buttons
            layout="col"
            buttons={header.buttons}
          />
        </Segment>
      </header>
    </>
  )
}
