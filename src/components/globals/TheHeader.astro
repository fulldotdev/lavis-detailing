---
import CartIcon from '@components/cart/CartIcon.svelte'
import Buttons from '@components/elements/button/Buttons.astro'
import Links from '@components/elements/link/Links.astro'
import Logo from '@components/elements/Logo.astro'
import Group from '@components/wrappers/Group.astro'
import Header from '@components/wrappers/Header.astro'
import List from '@components/wrappers/List.astro'
import { getGlobalSettings } from '@utils'
import { getEntry } from 'astro:content'

const header = await getEntry('data', 'header')
const settings = await getGlobalSettings('header')
---

<Header {...settings.header}>
  <Logo />
  <List
    {...settings.list}
    layout="row"
    y="center"
  >
    <Links
      links={header.data.links}
      {...settings.links}
    />
  </List>
  <Group class:list="max-lg:!hidden">
    <Buttons buttons={header.data.buttons} />
  </Group>

  <!-- Mobile -->
  <CartIcon client:load />
  <div class="gap-size3 flex items-center">
    <label
      class="w-1.4em h-1.4em flex cursor-pointer lg:hidden"
      for="header-toggle"
    >
      <i class="icon:menu peer-checked:icon:x h-full w-full"></i>
    </label>
  </div>
  <input
    id="header-toggle"
    class="peer hidden"
    type="checkbox"
  />
  <List
    layout="col"
    class:list="py-size4 z-90 bg-hue1 border-hue6 absolute left-0 right-0 top-full !hidden flex-col items-center border-y text-center backdrop-blur-lg peer-checked:max-lg:!flex"
  >
    <Links
      links={header.data.links}
      {...settings.links}
    />
  </List>
</Header>
