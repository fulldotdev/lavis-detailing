---
import Channels from '@components/elements/channel/Channels.astro'
import Links from '@components/elements/link/Links.astro'
import Logo from '@components/elements/Logo.astro'
import Socials from '@components/elements/social/Socials.astro'
import Footer from '@components/wrappers/Footer.astro'
import Group from '@components/wrappers/Group.astro'
import List from '@components/wrappers/List.astro'
import { getEntry } from 'astro:content'

const company = await getEntry('data', 'company')
const footer = await getEntry('data', 'footer')
const components = await getEntry('data', 'components')
const settings = components.data.globals.footer
---

<Footer {...settings?.footer}>
  <div class="col-span-1.2 mode-compact gap-size4 flex max-w-xs flex-col">
    <Logo />
    {
      company.data.description && (
        <p class="text-primary">{company.data.description}</p>
      )
    }
    <List layout="row">
      <Socials socials={settings.socials} />
    </List>
  </div>
  <div class="col-span-.8 gap-size5 mode-compact size-small flex flex-col">
    <h6 class="heading-secondary">Contact & locatie</h6>
    <Group
      {...settings?.group}
      layout="col"
    >
      <Channels channels={settings.channels} />
    </Group>
  </div>
  {
    footer?.data?.columns?.map((column: any) => (
      <div class="col-span-.8 gap-size5 mode-compact size-small flex flex-col">
        <h6 class="heading-secondary">{column.heading}</h6>
        <List
          class="w-full"
          {...settings.list}
        >
          <Links
            {...settings?.links}
            class="flex-col"
            links={column.links}
          />
        </List>
      </div>
    ))
  }
</Footer>
<div
  class="border-hue5 mx-wrapper py-size4 size-small flex flex-wrap justify-between border-t"
>
  <p class="text-size1">
    © {new Date().getFullYear()}&nbsp;{company.data.name}. Alle rechten
    voorbehouden.
  </p>
  <p class="text-size1 gap-x-size2 flex flex-wrap">
    {company.data.kvk && `Kvk. ${company.data.kvk}`}
    {
      footer.data?.policies?.map(
        (policy: string) =>
          typeof policy === 'object' && (
            <>
              <span>|</span>
              <a
                class="link size-small text-size1"
                href={policy.path}
              >
                {policy.title}
              </a>
            </>
          )
      )
    }
  </p>
</div>
