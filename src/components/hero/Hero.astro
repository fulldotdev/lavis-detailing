---
import { variants } from '../../data/variants'
import Button from '../button/Button.astro'
const {
  title,
  description,
  button = {},
  layout = false,
  variant = 'primary',
} = Astro.props
console.log(button)
---

<!-- primary: 'bg-blue p-100px',
secondary: 'bg-gray p-10px', --><!-- bg-blue -->
<section
  class:list={[
    { 'bg-red flex': layout },
    title,
    description,
    variants[variant],
  ]}
>
  <p>{Astro.props.title}</p>
  <p>
    <p>{Astro.props.description}</p>
  </p>
  <Button
    label="test"
    {...button}
  />
</section>
