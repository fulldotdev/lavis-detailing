---
import { getCollection } from 'astro:content'
import RenderBlock from './BlockBuilder.astro'

const { blocks } = Astro.props

const blocksCollection = await getCollection('blocks')
---

<main>
  {
    blocks?.map((block: any) => {
      const foundBlock = blocksCollection.find((entry) => {
        const entryName = entry.id.replace('.bookshop', '')
        const blockName = block._bookshop_name.replace(
          'src/content/blocks/',
          ''
        )
        return entryName === blockName
      })
      const settings = foundBlock?.data.config
      return (
        <RenderBlock
          {...settings}
          {...block}
        />
      )
    })
  }
</main>
