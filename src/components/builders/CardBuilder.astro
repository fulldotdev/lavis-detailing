---
import type { ButtonProps } from '@components/elements/button/Button.astro'
import Buttons from '@components/elements/button/ButtonGroup.astro'
import Image, { type ImageProps } from '@components/elements/image/Image.astro'
import Rating from '@components/elements/rating/Rating.astro'
import Writeup from '@components/elements/writeup/Writeup.astro'
import Card from '@components/wrappers/Card.astro'
import Segment from '@components/wrappers/Segment.astro'
import type { HTMLAttributes } from 'astro/types'
import { getEntry, type CollectionKey } from 'astro:content'

export type RenderCardProps = Props
interface Props {
  href?: HTMLAttributes<'a'>['href']
  image?: ImageProps
  buttons?: ButtonProps[]
  rating?: number
  writeup?: string
  title?: string
  tagline?: string
  description?: string
  person?: any
  type: CollectionKey | 'features' | 'offers'
}

const cards = await getEntry('globals', 'cards')
const settings = cards.data[Astro.props.type]
const merged = { ...settings, ...Astro.props }
const {
  href,
  card,
  image,
  rating,
  segment,
  writeup,
  title,
  description,
  tagline,
  buttons,
} = merged
---

<Card
  href={href}
  {...card}
>
  <Image {...image} />
  <Segment {...segment}>
    <Rating {...rating} />
    <Writeup
      html={writeup}
      {tagline}
      {title}
      {description}
    />
    <Buttons {buttons} />
  </Segment>
</Card>
