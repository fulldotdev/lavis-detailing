---
import Form from '@components/elements/Form.astro'
import Prose from '@components/elements/Prose.astro'
import Writeup from '@components/elements/Writeup.astro'
import { type ButtonProps } from '@components/elements/button/Button.astro'
import ButtonGroup from '@components/elements/button/ButtonGroup.astro'
import ChannelGroup from '@components/elements/channel/ChannelGroup.astro'
import Image, { type ImageProps } from '@components/elements/image/Image.astro'
import SocialGroup from '@components/elements/social/SocialGroup.astro'
import RenderCards from '@components/misc/RenderCards.astro'
import Deck, { type DeckProps } from '@components/wrappers/Deck.astro'
import { type GroupProps } from '@components/wrappers/Group.astro'
import Section, { type SectionProps } from '@components/wrappers/Section.astro'
import Segment, { type SegmentProps } from '@components/wrappers/Segment.astro'
import { type CollectionEntry } from 'astro:content'
import type { RenderCardProps } from './RenderCard.astro'

interface Props {
  // Elements and wrappers
  section?: SectionProps | null
  segment?: SegmentProps | null
  writeup?: string | null
  group: GroupProps | null
  buttons?: ButtonProps[] | null
  channels?: boolean | null
  socials?: boolean | null
  prose?: string | null
  form: string | null
  image?: ImageProps | null
  deck?: DeckProps | null
  // Collections
  categories?: CollectionEntry<'categories'>[] | null
  posts?: CollectionEntry<'posts'>[] | null
  products?: CollectionEntry<'products'>[] | null
  reviews?: CollectionEntry<'reviews'>[] | null
  services?: CollectionEntry<'services'>[] | null
  // Static cards
  features?: RenderCardProps[] | null
  highlights?: RenderCardProps[] | null
  offers?: RenderCardProps[] | null
}

const {
  // Elements and wrappers
  section,
  segment,
  writeup,
  group,
  buttons,
  channels,
  socials,
  prose,
  form,
  image,
  deck,
  // Collections
  categories,
  posts,
  products,
  reviews,
  services,
  // Static cards
  features,
  highlights,
  offers,
} = Astro.props
---

<Section {...section}>
  <Segment {...segment}>
    <Writeup {writeup} />
    <ButtonGroup
      {buttons}
      {...group}
    />
    <ChannelGroup
      {channels}
      {...group}
    />
    <SocialGroup {socials} />
  </Segment>
  <Prose {prose} />
  <Image {...image} />
  <Form {form} />
  <Deck {...deck}>
    <RenderCards
      {categories}
      {posts}
      {products}
      {reviews}
      {services}
      {features}
      {highlights}
      {offers}
    />
  </Deck>
</Section>
