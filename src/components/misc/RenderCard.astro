---
import type { ButtonProps } from '@components/elements/button/Button.astro'
import ButtonGroup from '@components/elements/button/ButtonGroup.astro'
import Image, { type ImageProps } from '@components/elements/image/Image.astro'
import Price from '@components/elements/Price.astro'
import Rating from '@components/elements/Rating.astro'
import Specs from '@components/elements/spec/Specs.astro'
import Writeup from '@components/elements/Writeup.astro'
import Card, { type CardProps } from '@components/wrappers/Card.astro'
import type { GroupProps } from '@components/wrappers/Group.astro'
import Segment, { type SegmentProps } from '@components/wrappers/Segment.astro'
import type { HTMLAttributes } from 'astro/types'

export type RenderCardProps = Props
interface Props {
  // Href
  href?: HTMLAttributes<'a'>['href']
  // Elements and wrappers
  card?: CardProps
  image?: ImageProps
  images?: ImageProps[]
  segment?: SegmentProps
  rating?: number | null
  writeup?: string | null
  tagline?: string | null
  title?: string | null
  description?: string | null
  price?: number
  specs?: string[] | null
  group?: GroupProps
  buttons?: ButtonProps[]
}

const {
  href,
  card,
  image,
  images,
  segment,
  rating,
  writeup,
  title,
  description,
  tagline,
  price,
  specs,
  group,
  buttons,
} = Astro.props

// TODO: clean this up
const myImage = images ? images[0] : image
const mergedImage = { ...myImage, ...image }
---

<Card
  {href}
  {...card}
>
  <Image {...mergedImage} />
  <Segment {...segment}>
    <Rating {rating} />
    <Writeup
      {writeup}
      {tagline}
      {title}
      {description}
    />
    <Price {price} />
    <Specs {specs} />
    <ButtonGroup
      {buttons}
      {...group}
    />
  </Segment>
</Card>
