---
import { SEO } from 'astro-seo'
import type { Image } from 'types'

interface Props {
  title?: string
  description?: string
  image?: string | Image
  noindex?: boolean
  nofollow?: boolean
  canonical?: string
  ogTitle?: string
}

const { title, description, image, ogTitle, noindex, nofollow, canonical } =
  Astro.props

const seo = {
  charset: 'UTF-8',
  title,
  description,
  noindex,
  nofollow,
  canonical,
  openGraph: {
    basic: {
      title: ogTitle || title || '',
      type: 'website',
      image: '',
    },
    image: {},
  },
}

if (typeof image === 'object' && image.url) {
  seo.openGraph.basic.image = image.url
  seo.openGraph.image = {
    url: image.url,
    secureUrl: image.url,
    type: image.mimeType,
    width: image.width,
    height: image.height,
    alt: image.alt,
  }
}
---

<meta
  content="width=device-width, initial-scale=1, viewport-fit=cover"
  name="viewport"
/>
<meta
  name="generator"
  content={Astro.generator}
/>

<SEO {...seo} />
