---
import Logo from '@components/elements/Logo.astro'
import Channels from '@components/elements/channel/ChannelGroup.astro'
import Links from '@components/elements/link/Links.astro'
import Socials from '@components/elements/social/SocialGroup.astro'
import Segment from '@components/wrappers/Segment.astro'
import { hue, scheme, size } from '@variants'
import { getEntry } from 'astro:content'
import { cva, type VariantProps } from 'cva'

interface Props extends VariantProps<typeof variant> {}

const variant = cva({
  base: 'area-block grid gap-size5 lg:grid-flow-col lg:auto-cols-fr size-small border-hue6 border-t relative z-20 justify-between',
  variants: {
    frame: {
      fill: 'px-wrapper py-size6',
      float: 'mx-wrapper py-size6',
      panel: 'mx-wrapper my-size6',
    },
    look: {
      ghost: 'bg-transparent',
      soft: 'bg-hue2',
      surface: 'bg-hue2 border border-hue6',
      outline: 'bg-transparent border border-hue6 ',
      solid:
        'bg-hue9 !text-hue-fg [&_*]:!text-hue-fg [&_.button]:(!bg-hue-fg !text-hue9)',
    },
    size: size,
    scheme: scheme,
    hue: hue,
  },
  defaultVariants: {
    frame: 'fill',
    look: 'ghost',
    size: 'medium',
  },
})

const company = await getEntry('globals', 'company')
const layout = await getEntry('globals', 'layout')
const footer = layout.data.footer
---

{
  footer && (
    <footer class={variant(footer)}>
      <Segment class:list="col-span-1.2 mode-compact size-medium max-w-xs">
        <Logo />
        {company?.data?.description && (
          <p class="text-primary">{company?.data?.description}</p>
        )}
        <Socials />
      </Segment>
      <Channels
        channels
        class:list="mode-compact size-medium"
      />
      {footer?.data?.columns &&
        footer?.data?.columns?.map((column: any) => (
          <Segment class:list="col-span-.8 mode-compact size-small">
            <h6 class="heading-secondary">{column.heading}</h6>
            <Links links={column.links} />
          </Segment>
        ))}
    </footer>
  )
}
