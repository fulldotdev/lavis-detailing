---
import { getEntry } from 'astro:content'
import merge from 'deepmerge'
import RenderBlock from './RenderBlock.astro'

const { blocks } = Astro.props
---

{
  blocks?.map(async (block: any) => {
    const blockSlug: any = block._bookshop_name?.split('/').pop()
    const blockEntry = await getEntry('blocks', `${blockSlug}.bookshop`)
    const blockConfig = blockEntry?.data?.config
    const merged: any = merge(blockConfig, block)
    return <RenderBlock {...merged} />
  })
}
