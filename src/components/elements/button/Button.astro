---
import type { HTMLAttributes, VariantProps } from '@types'
import { hue, scheme, size } from '@variants'
import { cva } from 'cva'

export type ButtonProps = Props
type Props = VariantProps<typeof variant> & {
  label: string | null
  href: HTMLAttributes<'a'>['href']
}

const variant = cva({
  base: 'gap-xs inline-flex cursor-pointer items-center justify-center whitespace-nowrap rounded-size1 p-size3 text-center text-button transition active:scale-95 disabled:pointer-events-none disabled:opacity-50 disabled:cursor-not-allowed',
  variants: {
    look: {
      solid: 'bg-hue9 text-hue-fg hover:bg-hue10 active:bg-hue11',
      soft: 'bg-hue3 text-hue11 [&[href]]:(hover:bg-hue4 active:bg-hue5)',
      surface:
        'bg-hue2 text-hue11 ring ring-inset ring-hue6 hover:(bg-hue3 ring-hue7) active:(bg-hue4 ring-hue8)',
      outline:
        'bg-transparent text-hue11 ring ring-inset ring-hue6 hover:(bg-hue2 ring-hue7) active:(bg-hue3 ring-hue8)',
      ghost: 'bg-transparent hover:bg-hue2 active:bg-hue3 text-hue11',
    },
    size,
    scheme,
    hue,
  },
  defaultVariants: {
    look: 'solid',
  },
})

const { label, href, ...restProps } = Astro.props
---

<a
  class={variant(restProps)}
  href={href}
  {...restProps}
>
  {label}
</a>
