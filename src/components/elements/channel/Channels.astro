---
import Group from '@components/wrappers/Group.astro'
import { getEntry } from 'astro:content'
import Channel from './Channel.astro'

interface Props {}

const company = await getEntry('data', 'company')
const keys = Object.keys(company.data.channels)
const filteredKeys = keys.filter((key) => company.data.channels[key])
---

<Group layout="col">
  {filteredKeys.map((key: any) => <Channel {key} />)}
</Group>
