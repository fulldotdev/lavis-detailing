---
import Group from '@components/wrappers/Group.astro'
import { getEntry } from 'astro:content'
import Channel from './Channel.astro'

interface Props {
  channels?: boolean
}

const { channels } = Astro.props

const company = await getEntry('globals', 'company')
const keys = Object.keys(company.data.channels)
const filteredKeys = keys.filter((key) => company.data.channels[key])
---

<Group direction="col">
  {channels && filteredKeys.map((key: any) => <Channel {key} />)}
</Group>
