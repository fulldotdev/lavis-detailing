---
import type { ChannelProps } from './Channel.astro'
import Channel from './Channel.astro'

type Props = ChannelProps & {
  channels: ChannelProps[]
}

const { channels, ...restProps } = Astro.props
---

{
  channels?.map((channel) => (
    <Channel
      {...channel}
      {...restProps}
    />
  ))
}
