---
import { getEntry } from 'astro:content'
import { variant } from '../input/Input.astro'
interface Props {
  label: string
  options: string[]
  required?: boolean
}

const { label, options, required } = Astro.props
const elements = await getEntry('globals', 'elements')
---

<div class="gap-size1 flex flex-col">
  <label for={label}>{label}</label>
  <select
    id={label}
    name={label}
    {required}
    class={variant(elements?.data.input)}
  >
    <option
      value="Niks geselecteerd"
      disabled
      selected
    >
      Maak een keuze
    </option>
    {options.map((option) => <option value={option}>{option}</option>)}
  </select>
</div>
