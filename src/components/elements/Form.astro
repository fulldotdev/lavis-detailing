---
import Input, { type InputProps } from '@components/elements/input/Input.astro'
import Select, {
  type SelectProps,
} from '@components/elements/select/Select.astro'
import Textarea, {
  type TextareaProps,
} from '@components/elements/textarea/Textarea.astro'
import type { HTMLAttributes } from 'astro/types'
import { getEntry } from 'astro:content'
import type { ButtonProps } from './button/Button.astro'
import Checkbox, { type CheckboxProps } from './checkbox/Checkbox.astro'

export type FormProps = Props
interface Props {
  form?: string | null
  title?: HTMLAttributes<'input'>['value'] | null
  key?: HTMLAttributes<'input'>['value'] | null
  inputs?: (InputProps | SelectProps | CheckboxProps | TextareaProps)[] | null
  button?: ButtonProps | null
}

const components: any = {
  input: Input,
  textarea: Textarea,
  select: Select,
  checkbox: Checkbox,
}

let {
  form,
  title,
  key,
  inputs,
  button = {
    label: 'Verstuur',
    href: '/bericht-ontvangen',
  },
} = Astro.props

const formName = form?.split('/').pop()?.replace('.md', '') || 'myplaceholder'
const formEntry = await getEntry('forms', formName)
const formData = formEntry ? formEntry.data : Astro.props

const inboxKey = import.meta.env.PUBLIC_APP_URL?.replace('https://', '')
  ?.replace('http://', '')
  ?.split('.')
  ?.shift()
---

{
  formData.inputs && (
    <form
      action={formData.button.href}
      class="gap-size2 flex w-full max-w-xl flex-col text-left"
    >
      {formData.inputs?.map((input: any) => {
        const key = input._bookshop_name.split('/').pop()
        const Component = components[key]
        return <Component {...input} />
      })}
      <slot />
      <input
        type="hidden"
        name="_subject"
        value={title}
      />
      <input
        type="hidden"
        name="inbox_key"
        value={inboxKey}
      />
      <input
        type="text"
        name="_gotcha"
        style="display: none;"
      />
      <button
        class="button-primary hue-brand mt-size2"
        type="submit"
      >
        {formData.button.label}
      </button>
    </form>
  )
}
