---
import { cva, type VariantProps } from 'cva'

export type ProseProps = Props
type Props = VariantProps<typeof variant> & {
  html?: any
}

const variant = cva({
  base: 'mx-auto [&_h1]:(heading mb-size3) [&_h1+p]:(mb-size6) [&_h2]:(heading mt-size5 mb-size3) [&_h3]:(subheading mt-size5 mb-size3) [&_p]:(text mt-size3) [&_*:fisrt-child]:mt-0 [&_*:last-child]:mb-0',
})

const { html, ...restProps } = Astro.props
---

{
  html && (
    <div
      class={variant(restProps)}
      {...restProps}
      set:html={html}
    />
  )
}
