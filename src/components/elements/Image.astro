---
import type { HTMLAttributes, Image } from '@types'
import { cva, type VariantProps } from 'cva'

export interface Props
  extends VariantProps<typeof variant>,
    Omit<HTMLAttributes<'img'>, 'sizes'> {
  exclude?: boolean | null
  image: Image | string | undefined | null
  sizes?: {
    base: string
    sm?: string
    md?: string
    lg?: string
    xl?: string
    '2xl'?: string
  }
}

const variant = cva({
  base: 'image',
  variants: {
    position: {
      relative: 'w-full h-auto relative',
      background: 'object-cover absolute inset-0 !h-full w-full',
      cover: 'object-cover h-full w-full',
    },
    orientation: {
      square: 'aspect-square',
    },
  },
  defaultVariants: {
    position: 'relative',
  },
})

const {
  exclude,
  image,
  loading = 'lazy',
  sizes = {
    base: '100vw',
  },
  ...restProps
} = Astro.props

function getSizes() {
  const mapped = Object.entries(sizes).map(([key, value]) => {
    if (key === 'base') return value
    if (key === 'sm') return `(min-width: 640px) ${value}`
    if (key === 'md') return `(min-width: 768px) ${value}`
    if (key === 'lg') return `(min-width: 1024px) ${value}`
    if (key === 'xl') return `(min-width: 1280px) ${value}`
    if (key === '2xl') return `(min-width: 1536px) ${value}`
  })
  const joined = mapped.join(', ')
  return joined
}

function getSrcset() {
  if (typeof image !== 'object') return
  if (!image?.sizes) return
  const webpSizes = Object.values(image.sizes).filter(
    (size) => size.mimeType === 'image/webp'
  )
  const mapped = webpSizes.map((size) => `${size?.url} ${size?.width}w`)
  const joined = mapped.join(', ')
  return joined
}
---

{
  !exclude && typeof image === 'object' && image?.url && (
    <img
      class:list={[variant(restProps)]}
      src={image.url}
      alt={image.alt}
      height={image.height}
      width={image.width}
      srcset={getSrcset()}
      sizes={getSizes()}
      loading={loading}
      decoding={loading === 'lazy' ? 'async' : 'sync'}
      {...restProps}
    />
  )
}

<style>
  .mask {
    -webkit-mask-image: linear-gradient(to top, transparent 0%, black 30%);
    mask-image: linear-gradient(to top, transparent 0%, black 30%);
  }
  .mask-lg {
    -webkit-mask-image: linear-gradient(to top, transparent 0%, black 100%);
    mask-image: linear-gradient(to top, transparent 0%, black 100%);
  }
</style>
