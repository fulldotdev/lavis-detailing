---
import type { Image as ImageType, Settings } from '@types'
import { getSettingsElement } from 'api'
import Image from './Image.astro'

interface Props {
  images: ImageType[] | undefined
  setting?: Settings['elements']['image']
}

const { images, setting, ...restProps } = Astro.props
const defaultSetting = await getSettingsElement('image')
---

{
  images &&
    images.length > 0 &&
    images?.map((image, i) => (
      <Image
        {...image}
        {...defaultSetting?.[i]}
        {...setting?.[i]}
        {...restProps}
      />
    ))
}
