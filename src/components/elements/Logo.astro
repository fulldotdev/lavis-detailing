---
import { getEntry } from 'astro:content'
import { cva } from 'cva'

const variant = cva({
  base: 'flex',
})

const company = await getEntry('globals', 'company')
const elements = await getEntry('globals', 'elements')
---

{
  company.data.logo && (
    <a
      class={variant(elements?.data.logo)}
      href="/"
    >
      <img
        class="text-primary h-2em block w-auto object-contain"
        src={company.data.logo}
        alt={'Logo ' + company.data.company}
        loading="lazy"
        decoding="async"
      />
    </a>
  )
}
