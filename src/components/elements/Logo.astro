---
import type { VariantProps } from '@types'
import { getElementSettings } from '@utils'
import { getEntry } from 'astro:content'
import { cva } from 'cva'

export type LogoProps = Props
type Props = VariantProps<typeof variant>

const variant = cva({
  base: '',
})

const { ...restProps } = Astro.props
const company = await getEntry('data', 'company')
const settings = await getElementSettings('logo')
---

{
  company.data.logo && (
    <a
      class:list={[variant(restProps), variant(settings)]}
      class="flex"
      href="/"
    >
      <img
        class="text-primary h-2em block w-auto object-contain"
        src={company.data.logo}
        alt={'Logo' + company.data.name}
        loading="lazy"
        decoding="async"
      />
    </a>
  )
}
