---
import type { HTMLAttributes } from '@types'
import { hue, size } from '@variants'
import { cva, type VariantProps } from 'cva'

export interface Props
  extends VariantProps<typeof variant>,
    HTMLAttributes<'a'> {
  label?: string
}

const variant = cva({
  base: 'link',
  variants: {
    size: size,
    hue: hue,
  },
})

const { href, label, ...restProps } = Astro.props
---

<a
  x-on=`rudderanalytics.track('buttonPressed',{href: ${href}}`
  href={href}
  class:list={[variant(restProps)]}
  {...restProps}
>
  {label}
</a>
