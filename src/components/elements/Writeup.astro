---
import { serialize } from '@utils/richtext'
import { getSettings } from 'api'

import type { HTMLAttributes } from '@types'
import { cva, type VariantProps } from 'cva'
interface Props extends VariantProps<typeof variant>, HTMLAttributes<'div'> {
  exclude?: boolean | null
  richtext?: any
}

const variant = cva({
  base: '[&_p]:mt-size2 [&_h1,&_h2,&_h3]:my-size3 [&_*:first-child]:mt-0 [&_*:last-child]:mb-0 [&_p:first-child:not(:last-child)]:(hue-brand text-size1)',
})

const { exclude, richtext, ...restProps } = Astro.props
const html = serialize(richtext?.root?.children)
const settings = await getSettings().then(({ elements }) => elements.writeup)
---

{
  !exclude && (Astro.slots.has('default') || richtext) && (
    <div
      class:list={[settings.className, variant(restProps)]}
      {...restProps}
    >
      {richtext ? <Fragment set:html={html} /> : <slot />}
    </div>
  )
}
