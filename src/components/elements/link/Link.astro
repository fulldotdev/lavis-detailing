---
import type { HTMLAttributes } from 'astro/types'
import { getEntry } from 'astro:content'
import { cva } from 'cva'

export type LinkProps = Props
interface Props {
  label: string | null
  href: HTMLAttributes<'a'>['href']
}

const variant = cva({
  base: 'link text-size-inherit',
})

const { href, label } = Astro.props
const elements = await getEntry('globals', 'elements')
---

<a
  href={href}
  class={variant(elements?.data.link)}
>
  {label}
</a>
