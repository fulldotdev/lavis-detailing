---
import iconsJson from '@iconify-json/tabler/icons.json'

const icons: any = iconsJson
const { name, className, exclude } = Astro.props

console.log(Astro.prop)
---

{
  !exclude && name && (
    <svg
      class:list={[className, 'w-2em h-2em']}
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      set:html={icons.icons[name]?.body}
    />
  )
}
