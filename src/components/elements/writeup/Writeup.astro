---
import { cva } from 'cva'
import bookshop from './writeup.bookshop.yml'

export type WriteupProps = Props
interface Props {
  html?: string
  tagline?: string
  title?: string
  description?: string
}

const variant = cva({
  base: '[&_p]:mt-size2 [&_h1,&_h2,&_h3]:my-size3 [&_*]:first:mt-0 [&_*]:last:mb-0 [&_p:first-child:not(:last-child)]:(hue-brand text-size1)',
})

const { html, tagline, title, description } = Astro.props
---

{
  (html || tagline || title || description) && (
    <div class={variant(bookshop.config)}>
      {tagline && <span>{tagline}</span>}
      {title && <h4>{title}</h4>}
      {description && <p>{description}</p>}
      {html && <Fragment set:html={html} />}
    </div>
  )
}
