---
import type { Settings } from '@types'
import { getCompany, getSettingsElement } from 'api'
import Social from './Social.astro'

interface Props {
  setting?: Settings['elements']['socials']
}

const { socials } = await getCompany()
const defaultSetting = await getSettingsElement('socials')
const { setting, ...restProps } = Astro.props
---

{
  socials?.map((social) => (
    <Social
      platform={social.social}
      url={social.link}
      {...defaultSetting}
      {...setting}
      {...restProps}
    />
  ))
}
