---
import Group from '@components/wrappers/Group.astro'
import { getEntry } from 'astro:content'
import Social from './Social.astro'

interface Props {
  socials?: boolean
}

const { socials } = Astro.props

const company = await getEntry('globals', 'company')
const keys = Object.keys(company.data.socials)
const filteredKeys = keys.filter((key) => company.data.socials[key])
---

<Group layout="row">
  {socials && filteredKeys.map((key: any) => <Social {key} />)}
</Group>
