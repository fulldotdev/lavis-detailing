---
import Group from '@components/wrappers/Group.astro'
import company from '@data/company.yml'
import Social from './Social.astro'

interface Props {
  socials?: boolean
}

const { socials } = Astro.props

const keys = Object.keys(company.socials)
const filteredKeys = keys.filter((key) => company.socials[key])
---

<Group layout="row">
  {socials && filteredKeys.map((key: any) => <Social {key} />)}
</Group>
