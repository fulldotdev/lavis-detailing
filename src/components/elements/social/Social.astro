---
import { getEntry } from 'astro:content'
import { variant } from '../button/Button.astro'

interface Props {
  key: keyof typeof map
}

const { key } = Astro.props
const company = await getEntry('globals', 'company')
const elements = await getEntry('globals', 'elements')

const map = {
  facebook: {
    href: company.data.facebook,
    icon: 'icon:brand-facebook',
  },
  instagram: {
    href: company.data.instagram,
    icon: 'icon:brand-instagram',
  },
  twitter: {
    href: company.data.twitter,
    icon: 'icon:brand-twitter',
  },
  pinterest: {
    href: company.data.pinterest,
    icon: 'icon:brand-pinterest',
  },
  linkedin: {
    href: company.data.linkedin,
    icon: 'icon:brand-linkedin',
  },
  youtube: {
    href: company.data.youtube,
    icon: 'icon:brand-youtube',
  },
  tiktok: {
    href: company.data.tiktok,
    icon: 'icon:brand-tiktok',
  },
  snapchat: {
    href: company.data.snapchat,
    icon: 'icon:brand-snapchat',
  },
}
---

{
  company.data.socials[key] && (
    <a
      class={variant(elements?.data.social)}
      href={map[key].href}
      target="_blank"
    >
      <i
        class="h-1.4em w-1.4em relative block text-inherit"
        class:list={map[key].icon}
      />
    </a>
  )
}
