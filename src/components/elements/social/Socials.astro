---
import Group from '@components/wrappers/Group.astro'
import { getEntry } from 'astro:content'
import Social from './Social.astro'

interface Props {}

const company = await getEntry('data', 'company')
const keys = Object.keys(company.data.socials)
const filteredKeys = keys.filter((key) => company.data.socials[key].length > 0)
---

<Group layout="row">
  {filteredKeys.map((key: any) => <Social {key} />)}
</Group>
