---
import type { Links, Settings } from '@types'
import { getSettingsElement } from 'api'
import type { Props as LinkProps } from './Link.astro'
import Link from './Link.astro'

interface Props extends LinkProps {
  links: Links | undefined | null
  setting?: Settings['elements']['links']
}

const { links, setting, ...restProps } = Astro.props
const defaultSetting = await getSettingsElement('buttons')

function getHref(button) {
  if (button.hrefSource === 'doc' && typeof button.doc === 'object')
    return button.doc?.value?.path
  else if (button.source === 'custom') return button.href
}
---

{
  links?.map((link) => (
    <Link
      href={getHref(link)}
      {...link}
      {...defaultSetting}
      {...setting}
      {...restProps}
    />
  ))
}
