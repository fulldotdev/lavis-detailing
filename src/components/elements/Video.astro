---
// import { YouTube } from '@astro-community/astro-embed-youtube';
import { Vimeo } from '@astro-community/astro-embed-vimeo'
import type { HTMLAttributes } from '@types'
import { cva, type VariantProps } from 'cva'

interface Props extends VariantProps<typeof variant>, HTMLAttributes<'div'> {
  video: any
}

const variant = cva({
  base: 'flex items-center gap-size4',
  variants: {
    position: {
      relative: '',
      background: 'object-cover absolute inset-0 !h-full w-full',
      cover: 'w-[100vw]',
    },
  },
})

const { video, position, class: className } = Astro.props
---

{
  video && (
    <Vimeo
      id="https://vimeo.com/831834222"
      params="autoplay=1&loop=1&muted=1&autopause=0,"
    />
  )
}
