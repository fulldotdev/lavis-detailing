---
import getElementConfig from '@utils/getElementConfig'
import { cva } from 'cva'

interface Props {
  label: string
  required?: boolean
}

export const variant = cva({
  base: 'gap-size3 p-size2 flex mt-size2 px-size3',
  variants: {
    look: {
      surface:
        'bg-hue2 text-hue12 ring ring-inset ring-hue6 hover:(ring-hue7) active:(ring-hue8)',
      soft: 'bg-hue3 text-hue12 hover:(ring ring-inset ring-hue7) active:(ring ring-inset ring-hue8)',
      outline:
        'bg-transparent text-hue12 ring-2 ring-inset ring-hue6 hover:(ring-hue7) active:(ring-hue8)',
    },
  },
  defaultVariants: {
    look: 'surface',
  },
})

const { label, required } = Astro.props
const config = await getElementConfig('checkbox')
---

<label
  for={label}
  class={variant(config)}
>
  <input
    type="checkbox"
    id={label}
    name={label}
    {required}
  />
  <span>{label}</span>
</label>
