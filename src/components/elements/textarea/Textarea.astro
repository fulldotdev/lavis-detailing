---
import { getEntry } from 'astro:content'
import { variant } from '../input/Input.astro'
interface Props {
  label: string
  required?: boolean
}

const { label, required } = Astro.props
const elements = await getEntry('globals', 'elements')
---

<div class="gap-size1 flex flex-col">
  <label for={label}>{label}</label>
  <textarea
    rows="5"
    class={variant(elements?.data.input)}
    id={label}
    name={label}
    {required}
  ></textarea>
</div>
