---
import getElementConfig from '@utils/getElementConfig'
import { variant } from '../input/Input.astro'

interface Props {
  label: string
  required?: boolean
}

const { label, required } = Astro.props
const config = await getElementConfig('textarea')
---

<div class="gap-size1 flex flex-col">
  <label for={label}>{label}</label>
  <textarea
    rows="5"
    class={variant(config)}
    id={label}
    name={label}
    {required}
  ></textarea>
</div>
