---
import getElementConfig from '@utils/getElementConfig'
import { cva } from 'cva'

interface Props {
  prose?: any
  Content?: any
}

const variant = cva({
  base: 'mx-auto [&_h1]:(heading mb-size3) [&_h1+p]:(mb-size6) [&_h2]:(heading mt-size5 mb-size3) [&_h3]:(subheading mt-size5 mb-size3) [&_p]:(text mt-size3) [&_*:fisrt-child]:mt-0 [&_*:last-child]:mb-0',
})

const { prose, Content } = Astro.props
const config = await getElementConfig('prose')
---

{
  (prose || Content) && (
    <div
      class={variant(config)}
      set:html={prose}
    >
      {Content && <Content />}
    </div>
  )
}
