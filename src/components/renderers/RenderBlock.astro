---
import Writeup from '@components/elements/Writeup.astro'
import Buttons from '@components/elements/button/Buttons.astro'
import Channels from '@components/elements/channel/Channels.astro'
import Image from '@components/elements/image/Image.astro'
import Socials from '@components/elements/social/Socials.astro'
import type { RenderCardsProps } from '@components/renderers/RenderCards.astro'
import RenderCards from '@components/renderers/RenderCards.astro'
import Deck from '@components/wrappers/Deck.astro'
import Section from '@components/wrappers/Section.astro'
import Segment from '@components/wrappers/Segment.astro'
import type {
  ButtonProps,
  DeckProps,
  ImageProps,
  SectionProps,
  SegmentProps,
} from '@types'

interface Props {
  section?: SectionProps
  segment?: SegmentProps
  writeup?: string
  buttons?: ButtonProps[]
  channels?: boolean
  socials?: boolean
  image?: ImageProps | null
  deck?: DeckProps
  features?: RenderCardsProps
}

const {
  section,
  segment,
  writeup,
  buttons,
  image,
  channels,
  socials,
  deck,
  features,
} = Astro.props
---

<Section {...section}>
  <Segment {...segment}>
    <Writeup set:html={writeup} />
    <Buttons {buttons} />
    <Channels {channels} />
    <Socials {socials} />
  </Segment>

  <Image {...image} />
  <Deck {...deck}>
    <RenderCards
      items={features}
      type="features"
    />
  </Deck>
</Section>
