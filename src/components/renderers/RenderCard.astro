---
import Buttons from '@components/elements/button/Buttons.astro'
import Image, { type ImageProps } from '@components/elements/image/Image.astro'
import Rating from '@components/elements/rating/Rating.astro'
import Card from '@components/wrappers/Card.astro'
import Segment from '@components/wrappers/Segment.astro'
import Writeup from '@components/wrappers/Writeup.astro'
import type { ButtonProps } from '@types'
import type { HTMLAttributes } from 'astro/types'
import { getEntry, type CollectionKey } from 'astro:content'

export type RenderCardProps = Props
interface Props {
  href?: HTMLAttributes<'a'>['href']
  image?: ImageProps
  buttons?: ButtonProps[]
  rating?: number
  writeup?: string
  title?: string
  tagline?: string
  description?: string
  person?: any
  type: CollectionKey | 'features' | 'offers'
}

const components = await getEntry('data', 'components')
const settings = components.data.elements[Astro.props.type]
const merged = { ...settings, ...Astro.props }
const {
  href,
  card = {},
  image = {},
  rating = {},
  segment = {},
  writeup = {},
  title,
  description,
  tagline,
  buttons = [],
} = merged
---

<Card
  href={href}
  {...card}
>
  <Image {...image} />
  <Rating {...rating} />
  <Segment {...segment}>
    <Writeup {...writeup}>
      {tagline && <span>{tagline}</span>}
      {title && <h4>{title}</h4>}
      {description && <p>{description}</p>}
    </Writeup>
    <Buttons {buttons} />
  </Segment>
</Card>
