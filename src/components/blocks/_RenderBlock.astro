---
import type { CardsBuilderItem } from '@components/cards/_RenderCards.astro'
import RenderCards from '@components/cards/_RenderCards.astro'
import { type ButtonProps } from '@components/elements/button/Button.astro'
import ButtonGroup from '@components/elements/button/ButtonGroup.astro'
import ChannelGroup from '@components/elements/channel/ChannelGroup.astro'
import Image, { type ImageProps } from '@components/elements/image/Image.astro'
import Socials from '@components/elements/social/SocialGroup.astro'
import Writeup from '@components/elements/writeup/Writeup.astro'
import Deck, { type DeckProps } from '@components/wrappers/Deck.astro'
import { type GroupProps } from '@components/wrappers/Group.astro'
import Section, { type SectionProps } from '@components/wrappers/Section.astro'
import Segment, { type SegmentProps } from '@components/wrappers/Segment.astro'

export type BlockBuilderProps = Props
interface Props {
  section?: SectionProps
  segment?: SegmentProps
  writeup?: string
  group: GroupProps
  buttons?: ButtonProps[]
  channels?: boolean
  socials?: boolean
  image?: ImageProps | null
  deck?: DeckProps
  features?: CardsBuilderItem[]
  highlights?: CardsBuilderItem[]
  persons?: CardsBuilderItem[]
  offers?: CardsBuilderItem[]
  products?: CardsBuilderItem[]
  services?: CardsBuilderItem[]
  reviews?: CardsBuilderItem[]
  posts?: CardsBuilderItem[]
  categories?: CardsBuilderItem[]
}

const {
  section,
  segment,
  writeup,
  group,
  buttons,
  image,
  channels,
  socials,
  deck,
  features,
  highlights,
  offers,
  persons,
  products,
  services,
  reviews,
  posts,
  categories,
} = Astro.props

const items = [
  features,
  highlights,
  offers,
  persons,
  products,
  services,
  reviews,
  posts,
  categories,
]
  .flat()
  .filter(Boolean)
---

<Section {...section}>
  <Segment {...segment}>
    <Writeup html={writeup} />
    <ButtonGroup
      {buttons}
      {...group}
    />
    <ChannelGroup {channels} />
    <Socials {socials} />
  </Segment>
  <Image {...image} />
  <Deck {...deck}>
    <RenderCards items={items} />
  </Deck>
</Section>
