---
// import Icon from '@components/elements/icon/Icon.astro'
import Buttons from '@components/elements/button/Buttons.astro'
import Image from '@components/elements/image/Image.astro'
import Writeup from '@components/elements/writeup/Writeup.astro'
import Card from '@components/wrappers/Card.astro'
import Group from '@components/wrappers/Group.astro'
import Segment from '@components/wrappers/Segment.astro'
import { getCardSettings } from '@utils'

const merged = { ...(await getCardSettings('features')), ...Astro.props }
const { card, image, segment, writeup, group, buttons } = merged
---

<Card {...card}>
  <Image
    sizes={{ base: '470px' }}
    {...image}
  />
  <Segment {...segment}>
    <!-- <Icon
      iconName={card.icon}
      {...Icon}
    /> -->
    <Writeup {...writeup} />
    <Group {...group}>
      <Buttons {buttons} />
    </Group>
  </Segment>
</Card>
