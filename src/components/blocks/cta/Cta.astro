---
import Button from '@components/elements/button/Button.astro'
import Image from '@components/elements/image/Image.astro'
import Writeup from '@components/elements/writeup/Writeup.astro'
import Group from '@components/wrappers/Group.astro'
import Section from '@components/wrappers/Section.astro'
import Segment from '@components/wrappers/Segment.astro'
import type {
  ButtonProps,
  ImageProps,
  SectionProps,
  SegmentProps,
  WriteupProps,
} from '@types'

export type HeroProps = Props
type Props = {
  variant: 'primary' | 'secondary'
  section: SectionProps
  segment: SegmentProps
  writeup: WriteupProps
  buttons: ButtonProps[]
  image: ImageProps
}

const { section, segment, writeup, buttons, image } = Astro.props
---

<Section {...section}>
  <Segment {...segment}>
    <Writeup {...writeup} />
    <Group {...section}>
      {buttons?.map((button) => <Button {...button} />)}
    </Group>
  </Segment>
  <Image {...image} />
</Section>
