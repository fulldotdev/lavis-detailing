---
import Buttons from '@components/elements/button/Buttons.astro'
import Image from '@components/elements/image/Image.astro'
import Writeup from '@components/elements/writeup/Writeup.astro'
import Group from '@components/wrappers/Group.astro'
import Section from '@components/wrappers/Section.astro'
import Segment from '@components/wrappers/Segment.astro'
import type {
  ButtonProps,
  GroupProps,
  ImageProps,
  SectionProps,
  SegmentProps,
  WriteupProps,
} from '@types'

interface Props {
  section: SectionProps
  segment: SegmentProps
  writeup: WriteupProps
  group: GroupProps
  buttons: ButtonProps[]
  image: ImageProps
}

const {
  section = {},
  segment = {},
  writeup = {},
  group = {},
  buttons = [],
  image = {},
} = Astro.props
---

<Section {...section}>
  <Segment {...segment}>
    <Writeup {...writeup} />
    <Group {...group}>
      <Buttons {buttons} />
    </Group>
  </Segment>
  <Image {...image} />
</Section>
