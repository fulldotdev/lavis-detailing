---
import Price from '@components/elements/Price.astro'
import Image from '@components/elements/image/Image.astro'
import Writeup from '@components/elements/writeup/Writeup.astro'
import Card from '@components/wrappers/card/Card.astro'
import Segment from '@components/wrappers/segment/Segment.astro'
import type { CardProps, ImageProps, SegmentProps, WriteupProps } from '@types'

export type BrandsCardProps = Props
interface Props {
  card?: CardProps
  image?: ImageProps
  segment?: SegmentProps
  writeup?: WriteupProps
  product: any
}

const {
  card = {},
  image = {},
  segment = {},
  writeup = {},
  product = {},
} = Astro.props
---

<Card {...card}>
  <Image
    sizes={{ base: '470px' }}
    orientation="square"
    {...image}
  />
  <Segment {...segment}>
    <Writeup {...writeup}>
      <h4 class="heading-secondary">{product.title}</h4>
      {product.price && <Price price={product.price} />}
    </Writeup>
  </Segment>
</Card>
