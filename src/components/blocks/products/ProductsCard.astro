---
import Price from '@components/elements/Price.astro'
import Image from '@components/elements/image/Image.astro'
import Writeup from '@components/elements/writeup/Writeup.astro'
import Card from '@components/wrappers/Card.astro'
import Segment from '@components/wrappers/Segment.astro'
import { getCardSettings } from '@utils'

const props = { ...(await getCardSettings('products')), ...Astro.props }
const { card, image, segment, writeup, product } = props
---

<Card
  {...card}
  href={'/producten/' + product.slug}
>
  <Image
    sizes={{ base: '470px' }}
    orientation="square"
    {...image}
  />
  <Segment {...segment}>
    <Writeup {...writeup}>
      <h4 class="heading-secondary">{product.data.title}</h4>
      {product.data.price && <Price price={product.data.price} />}
    </Writeup>
  </Segment>
</Card>
