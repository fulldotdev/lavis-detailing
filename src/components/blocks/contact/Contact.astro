---
import Channels from '@components/elements/channel/Channels.astro'
import Socials from '@components/elements/social/Socials.astro'
import Writeup from '@components/elements/writeup/Writeup.astro'
// import FormWithRenderer from '@components/wrappers/FormWithRenderer.svelte'
import Group from '@components/wrappers/group/Group.astro'
import List from '@components/wrappers/list/List.astro'
import Section from '@components/wrappers/section/Section.astro'
import Segment from '@components/wrappers/segment/Segment.astro'
import type {
  ChannelProps,
  // FormProps,
  GroupProps,
  ListProps,
  SectionProps,
  SegmentProps,
  SocialProps,
  WriteupProps,
} from '@types'

type Props = {
  section: SectionProps
  segment: SegmentProps
  writeup: WriteupProps
  group: GroupProps
  channels: ChannelProps[]
  list: ListProps
  socials: SocialProps[]
  // form: FormProps
}

const {
  section = {},
  segment = {},
  writeup = {},
  group = {},
  channels = [],
  list = {},
  socials = [],
} = Astro.props
---

<Section {...section}>
  <Segment {...segment}>
    <Writeup {...writeup} />
    <Group {...group}>
      <Channels {channels} />
    </Group>
    <List {...list}>
      <Socials {socials} />
    </List>
  </Segment>
  <!-- <FormWithRenderer
    client:load
    form={form}
    {...form}
  /> -->
</Section>
