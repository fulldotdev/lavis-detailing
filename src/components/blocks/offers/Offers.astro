---
import OffersCard from '@components/blocks/offers/OffersCard.astro'
import Writeup from '@components/elements/writeup/Writeup.astro'
import Deck from '@components/wrappers/deck/Deck.astro'
import Section from '@components/wrappers/section/Section.astro'
import type {
  DeckProps,
  OffersCardProps,
  SectionProps,
  WriteupProps,
} from '@types'

interface Props {
  section: SectionProps
  writeup: WriteupProps
  deck: DeckProps
  offers: OffersCardProps
}

const { section = {}, writeup = {}, deck = {}, offers = {} } = Astro.props
---

<Section {...section}>
  <Writeup {...writeup} />
  <Deck {...deck}>
    <OffersCard {...offers} />
  </Deck>
</Section>
