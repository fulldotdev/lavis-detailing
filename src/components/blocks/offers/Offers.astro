---
import Writeup from '@components/elements/writeup/Writeup.astro'
import Deck from '@components/wrappers/Deck.astro'
import Section from '@components/wrappers/Section.astro'
import { getBlockSettings } from '@utils'
import OffersCards from './OffersCards.astro'

const merged = { ...(await getBlockSettings('offers')), ...Astro.props }
const { writeup, offers, section, deck } = merged
---

<Section {...section}>
  <Writeup {...writeup} />
  <Deck {...deck}>
    <OffersCards {offers} />
  </Deck>
</Section>
