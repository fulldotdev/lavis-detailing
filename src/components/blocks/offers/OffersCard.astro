---
import Buttons from '@components/elements/button/Buttons.astro'
import Specs from '@components/elements/spec/Specs.astro'
import Writeup from '@components/elements/writeup/Writeup.astro'
import Card from '@components/wrappers/Card.astro'
import Group from '@components/wrappers/Group.astro'
import List from '@components/wrappers/List.astro'
import Segment from '@components/wrappers/Segment.astro'
import { getCardSettings } from '@utils'

const merged = { ...(await getCardSettings('offers')), ...Astro.props }
const { card, segment, specs, list, writeup, group, buttons } = merged
---

<Card {...card}>
  <Segment {...segment}>
    <Writeup {...writeup} />
    <List {...list}>
      <Specs {specs} />
    </List>
    <Group {...group}>
      <Buttons {buttons} />
    </Group>
  </Segment>
</Card>
