---
import Buttons from '@components/elements/button/Buttons.astro'
import Spec from '@components/elements/spec/Spec.astro'
import Writeup from '@components/elements/writeup/Writeup.astro'
import Card from '@components/wrappers/card/Card.astro'
import Group from '@components/wrappers/group/Group.astro'
import List from '@components/wrappers/list/List.astro'
import Segment from '@components/wrappers/segment/Segment.astro'
import type {
  ButtonProps,
  CardProps,
  GroupProps,
  ListProps,
  SegmentProps,
  SpecProps,
  WriteupProps,
} from '@types'

export type OffersCardProps = Props
interface Props {
  card?: CardProps
  segment?: SegmentProps
  writeup?: WriteupProps
  list?: ListProps
  specs?: SpecProps[]
  group?: GroupProps
  buttons?: ButtonProps[]
}

const {
  card = {},
  segment = {},
  writeup = {},
  list = {},
  specs = [],
  group = {},
  buttons = [],
} = Astro.props
---

<Card {...card}>
  <Segment
    class:list="gap-size5 flex h-full flex-col"
    {...segment}
  >
    <Writeup {...writeup} />
    <List
      class:list="mb-size4"
      {...list}
    >
      {specs?.map((spec) => <Spec {...spec} />)}
    </List>
    <Group
      class:list="mt-auto w-full"
      {...group}
    >
      <Buttons {buttons} />
    </Group>
  </Segment>
</Card>
