---
import Image from '@components/elements/image/Image.astro'
import Writeup from '@components/elements/writeup/Writeup.astro'
import Card from '@components/wrappers/Card.astro'
import Segment from '@components/wrappers/Segment.astro'
import { getCardSettings } from '@utils'

const merged = { ...(await getCardSettings('brands')), ...Astro.props }
const { card, image, segment, entry } = merged
---

<Card
  href={'/brands/' + entry.slug}
  {...card}
>
  <Image
    {...image}
    {...entry.data.image}
  />
  <Segment {...segment}>
    <Writeup>
      {entry.data.title && <h4>{entry.data.title}</h4>}
      {entry.data.description && <p>{entry.data.description}</p>}
    </Writeup>
  </Segment>
</Card>
