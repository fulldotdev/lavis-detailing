---
import Buttons from '@components/elements/button/Buttons.astro'
import Writeup from '@components/elements/writeup/Writeup.astro'
import Deck from '@components/wrappers/deck/Deck.astro'
import Group from '@components/wrappers/group/Group.astro'
import Section from '@components/wrappers/section/Section.astro'
import Segment from '@components/wrappers/segment/Segment.astro'
import type {
  ButtonProps,
  DeckProps,
  GroupProps,
  SectionProps,
  SegmentProps,
  WriteupProps,
} from '@types'
import BrandsCard from './BrandsCard.astro'

interface Props {
  section?: SectionProps
  segment?: SegmentProps
  writeup?: WriteupProps
  group?: GroupProps
  buttons?: ButtonProps[]
  deck?: DeckProps
  brands: any[]
}

const {
  section = {},
  segment = {},
  writeup = {},
  group = {},
  buttons = [],
  deck = {},
  brands = [],
} = Astro.props
---

<Section {...section}>
  <Segment {...segment}>
    <Writeup {...writeup} />
    <Group {...group}>
      <Buttons {buttons} />
    </Group>
  </Segment>
  <Deck {...deck}>
    {brands?.map((brand) => <BrandsCard brand={brand} />)}
  </Deck>
</Section>
