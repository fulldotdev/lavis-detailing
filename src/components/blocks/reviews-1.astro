---
import { cn } from "@/lib/utils"
import { Avatar, AvatarImage } from "@/components/ui/avatar"
import { Image } from "@/components/ui/image"
import {
  Item,
  ItemContent,
  ItemDescription,
  ItemMedia,
  ItemTitle,
} from "@/components/ui/item"
import { Rating } from "@/components/ui/rating"
import {
  Section,
  SectionContent,
  SectionMasonry,
  SectionProse,
  SectionSpread,
} from "@/components/ui/section"
import { Tile, TileContent, TileDescription } from "@/components/ui/tile"

interface Props {
  class?: string
  id?: string
  item?: {
    href?: string
    image?: {
      src: string
      alt: string
    }
    rating?: number
    description?: string
  }
  items?: {
    title?: string
    description?: string
    rating?: number
    href?: string
    image?: {
      src: string
      alt: string
    }
    tagline?: string
  }[]
}

const { class: className, id, item, items } = Astro.props
---

<Section class={cn("", className)} id={id}>
  <SectionSpread class="@5xl:items-end">
    <SectionContent class="items-start">
      <SectionProse>
        <slot />
      </SectionProse>
    </SectionContent>
    <Item href={item?.href} target="_blank" variant="muted">
      <ItemMedia variant="image">
        <Image {...item?.image} />
      </ItemMedia>
      <ItemContent>
        <Rating rating={item?.rating} />
        <ItemDescription class="line-clamp-none">
          {item?.description}
        </ItemDescription>
      </ItemContent>
    </Item>
  </SectionSpread>

  <SectionMasonry>
    {
      items?.map(({ title, description, rating, href, image, tagline }) => (
        <Tile href={href} frame="panel" variant="outline">
          <TileContent>
            <Rating rating={rating} />
            <TileDescription>{description}</TileDescription>
            <Item class="-m-4">
              <ItemMedia>
                <Avatar>
                  <AvatarImage src={image?.src} alt={image?.alt} />
                </Avatar>
              </ItemMedia>
              <ItemContent>
                <ItemTitle>{title}</ItemTitle>
                <ItemDescription>{tagline}</ItemDescription>
              </ItemContent>
            </Item>
          </TileContent>
        </Tile>
      ))
    }
  </SectionMasonry>
</Section>
