---
import Buttons from '@components/elements/button/Buttons.astro'
import Writeup from '@components/elements/writeup/Writeup.astro'
import Deck from '@components/wrappers/Deck.astro'
import Group from '@components/wrappers/Group.astro'
import Section from '@components/wrappers/Section.astro'
import Segment from '@components/wrappers/Segment.astro'
import { getBlockSettings } from '@utils'
import PostsCards from './PostsCards.astro'

const props = { ...(await getBlockSettings('brands')), ...Astro.props }
const { section, segment, writeup, group, buttons, deck, brands } = props
---

<Section {...section}>
  <Segment {...segment}>
    <Writeup {...writeup} />
    <Group {...group}>
      <Buttons {buttons} />
    </Group>
  </Segment>
  <Deck {...deck}>
    <PostsCards {posts} />
  </Deck>
</Section>
