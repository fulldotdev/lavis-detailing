---
import Writeup from '@components/elements/Writeup.astro'
import RenderCards from '@components/misc/RenderCards.astro'
import Deck from '@components/wrappers/Deck.astro'
import Section from '@components/wrappers/Section.astro'
import NavLayout from '@layouts/NavLayout.astro'
import { getCollection, type CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'categories'>
}

const { data, slug } = Astro.props.entry

const products = await getCollection('products', (product) => {
  if (product.data.draft) return false
  return product.data.categories?.some((category: any) => {
    if (!category) return
    return category.includes(slug)
  })
})

const categories = await getCollection('categories')
---

<NavLayout seo={data.seo}>
  <Section class:list="pb-0">
    <Writeup {...data} />
  </Section>
  <Section>
    <Deck layout="grid">
      <RenderCards {products} />
    </Deck>
  </Section>
  <Section>
    <h2>Bekijk ook eens</h2>
    <Deck layout="carousel">
      <RenderCards {categories} />
    </Deck>
  </Section>
</NavLayout>
