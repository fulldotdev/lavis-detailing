---
import Prose from '@components/elements/Prose.astro'
import Section from '@components/wrappers/Section.astro'
import type { CollectionEntry } from 'astro:content'
import NavLayout from './NavLayout.astro'

interface Props {
  entry: CollectionEntry<'policies'>
}

const { data, render } = Astro.props.entry
const { Content } = await render()
---

<NavLayout seo={data.seo}>
  <Section
    align="center"
    frame="float"
  >
    <Prose {Content} />
  </Section>
</NavLayout>
