---
import Price from '@components/elements/Price.astro'
import Prose from '@components/elements/Prose.astro'
import Writeup from '@components/elements/Writeup.astro'
import GalleryScroll from '@components/elements/gallery/GalleryScroll.svelte'
import Image from '@components/elements/image/Image.astro'
import CartUpdateButton from '@components/globals/cart/CartUpdateButton.svelte'
import RenderCards from '@components/misc/RenderCards.astro'
import Deck from '@components/wrappers/Deck.astro'
import Section from '@components/wrappers/Section.astro'
import Segment from '@components/wrappers/Segment.astro'
import NavLayout from '@layouts/NavLayout.astro'
import { getCollection, type CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'products'>
}

const { data, render } = Astro.props.entry
const { Content } = await render()
const products = await getCollection('products', (product) => {
  if (product.data.draft || !product.data._stripe_price_id) return false
  return true
})
---

<!-- Temporary untill astro/svelte bug is fixed -->
<NavLayout
  seo={{
    title: data.title,
    description: data.summary,
    image: data.images[0]?.src,
  }}
>
  <Section
    layout="row"
    align="start"
  >
    <GalleryScroll class="col-span-2">
      {data.images?.map((image: any) => <Image {...image} />)}
    </GalleryScroll>
    <Segment>
      <Writeup>
        <h1 class="heading-primary">{data.title}</h1>
        <p class="text">{data.description}</p>
      </Writeup>
      <Price
        class="size-large text-size2 text-hue12"
        price={data.price}
      />
      <CartUpdateButton
        data={data}
        client:load
      />
    </Segment>
  </Section>
  <Section>
    <Prose {Content} />
  </Section>
  <Section
    layout="col"
    size="medium"
  >
    <h2 class="heading">Meer producten</h2>
    <Deck
      layout="carousel"
      size="medium"
    >
      <RenderCards {products} />
    </Deck>
  </Section>
</NavLayout>

<div class="hidden">
  <CartUpdateButton
    data={data}
    client:load
  />
</div>
