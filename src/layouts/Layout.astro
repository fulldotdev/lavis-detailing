---
import TheBottom from '@components/globals/TheBottom.astro'
import Seo from '@components/misc/Seo.astro'
import { ViewTransitions } from 'astro:transitions'

const { meta } = Astro.props
---

<!doctype html>
<html
  lang="nl"
  class="scroll-smooth"
>
  <head>
    <Seo {...meta} />
    <ViewTransitions />
  </head>
  <body class="size-medium mode-base hue-base bg-hue1 scroll-smooth">
    <slot />
    <TheBottom />
    <style is:global>
      [x-cloak] {
        display: none !important;
      }
    </style>
    <script
      defer
      is:inline
      src="https://cdn.jsdelivr.net/npm/@alpinejs/intersect@3.x.x/dist/cdn.min.js"
    ></script>
    <script
      defer
      is:inline
      src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"
    ></script>
  </body>
</html>
