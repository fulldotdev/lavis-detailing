---
import Seo from '@components/misc/Seo.astro'
import { ViewTransitions } from 'astro:transitions'

const { seo } = Astro.props
---

<!doctype html>
<html
  lang="nl"
  class="size-medium mode-base bg-hue1 scroll-smooth"
>
  <head>
    <Seo {...seo} />
    <ViewTransitions />
  </head>
  <body class="size-medium mode-base hue-base bg-hue1 scroll-smooth">
    <slot />
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-WF6P2C9P"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
  </body>
</html>
