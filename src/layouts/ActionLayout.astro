---
import Whatsapp from '@components/elements/Whatsapp.astro'
import Footer from '@components/globals/Footer.astro'
import Header from '@components/globals/Header.astro'
import Legal from '@components/globals/Legal.astro'
import CartSidebar from '@components/globals/cart/Cart.svelte'
import RenderBlock from '@components/misc/RenderBlock.astro'
import { getEntry } from 'astro:content'
import Layout from './Layout.astro'

const cta = await getEntry('globals', 'cta')
const globals = await getEntry('settings', 'globals')
const merged = { ...cta.data, ...globals?.data.cta }

const { seo } = Astro.props
---

<Layout {seo}>
  <Header />
  <CartSidebar client:load />
  <main>
    <slot />
    <RenderBlock {...merged} />
    <Whatsapp />
  </main>
  <Footer />
  <Legal />
</Layout>
