---
import Whatsapp from '@components/elements/Whatsapp.astro'
import RenderBlock from '@components/renderers/RenderBlock.astro'
import LayoutNav from '@layouts/LayoutNav.astro'
import { getEntry } from 'astro:content'

const cta = await getEntry('globals', 'cta')

const { seo } = Astro.props
---

<LayoutNav {seo}>
  <slot />
  <RenderBlock
    _bookshop_name="blocks/cta"
    {...cta.data}
  />
  <Whatsapp />
</LayoutNav>
