---
import BlocksBuilder from '@components/blocks/_RenderBlocks.astro'
import ActionLayout from '@layouts/ActionLayout.astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'pages'>
}

const { data } = Astro.props.entry
---

<ActionLayout seo={data.seo}>
  <BlocksBuilder blocks={data.content_blocks} />
</ActionLayout>
