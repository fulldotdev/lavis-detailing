---
import BlocksBuilder from '@components/blocks/_RenderBlocks.astro'
import ActionsLayout from '@layouts/ActionsLayout.astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  service: CollectionEntry<'services'>
}

const { data } = Astro.props.service
---

<ActionsLayout seo={data.seo}>
  <BlocksBuilder blocks={data.content_blocks} />
</ActionsLayout>
