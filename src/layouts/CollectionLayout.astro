---
import type { CollectionEntry, ContentCollectionKey } from 'astro:content'
import CategoryLayout from './CategoryLayout.astro'
import PageLayout from './PageLayout.astro'
import PolicyLayout from './PolicyLayout.astro'
import PostLayout from './PostLayout.astro'
import ProductLayout from './ProductLayout.astro'
import ServiceLayout from './ServiceLayout.astro'

interface Props {
  entry: CollectionEntry<ContentCollectionKey>
}

const layouts: {
  [key in ContentCollectionKey]: any
} = {
  pages: PageLayout,
  policies: PolicyLayout,
  posts: PostLayout,
  products: ProductLayout,
  services: ServiceLayout,
  categories: CategoryLayout,
  forms: PageLayout,
  reviews: PageLayout,
}

const { entry } = Astro.props
const Layout = layouts[entry.collection]
---

<Layout {entry} />
