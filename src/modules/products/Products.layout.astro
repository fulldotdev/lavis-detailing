---
import CartUpdateButton from '@components/cart/CartUpdateButton.svelte'
import Price from '@components/elements/Price.astro'
import Writeup from '@components/elements/Writeup.astro'
import GalleryScroll from '@components/elements/gallery/GalleryScroll.svelte'
import Image from '@components/elements/image/Image.astro'
import RenderCards from '@components/renderers/RenderCards.astro'
import Deck from '@components/wrappers/Deck.astro'
import Section from '@components/wrappers/Section.astro'
import Segment from '@components/wrappers/Segment.astro'
import LayoutNav from '@layouts/LayoutNav.astro'
import { getCollection, type CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'products'>
}

const { data, render } = Astro.props.entry
const { Content } = await render()
const collection = await getCollection('products')
---

<!-- Temporary untill astro/svelte bug is fixed -->
<div class="hidden">
  <CartUpdateButton
    data={data}
    client:load
  />
</div>

<LayoutNav>
  <Section
    layout="row"
    align="start"
  >
    <GalleryScroll class="col-span-2">
      {data.images?.map((image: any) => <Image {...image} />)}
    </GalleryScroll>
    <Segment>
      <Writeup>
        <h1 class="heading-primary">{data.title}</h1>
        <p class="text">{data.description}</p>
      </Writeup>
      <Price
        class="size-large text-size2 text-hue12"
        price={data.price}
      />
      <CartUpdateButton
        data={data}
        client:load
      />
    </Segment>
  </Section>
  <Section>
    <Content />
    <!-- <Prose set:html={product.data.render()} /> -->
  </Section>
  <Section
    layout="col"
    size="medium"
  >
    <h2 class="heading">Meer producten</h2>
    <Deck
      layout="carousel"
      size="medium"
    >
      <RenderCards items={collection} />
    </Deck>
  </Section>
</LayoutNav>
