---
import Writeup from '@components/elements/Writeup.astro'
import Image from '@components/elements/image/Image.astro'
import Prose from '@components/wrappers/Prose.astro'
import Section from '@components/wrappers/Section.astro'
import Segment from '@components/wrappers/Segment.astro'
import type { CollectionEntry } from 'astro:content'
import LayoutNav from '../../layouts/LayoutNav.astro'

interface Props {
  entry: CollectionEntry<'posts'>
}

const { data, render } = Astro.props.entry
const { Content } = await render()
---

<LayoutNav seo={data.seo}>
  <Section
    size="large"
    frame="float"
    class:list="!max-w-5xl lg:mx-auto !pt-size5"
  >
    <Segment>
      <Writeup>
        <h1 class="heading-primary">{data.title}</h1>
        <p class="text-primary">{data.description}</p>
      </Writeup>
    </Segment>
    <Image {...data.image} />
  </Section>
  <Section
    frame="float"
    class:list="!max-w-4xl lg:mx-auto !pt-size5 w-full"
  >
    <Prose>
      <Content />
    </Prose>
  </Section>
</LayoutNav>
