{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@*": ["src/*"],
      "@core/*": ["src/core/*"],
      "@layouts/*": ["src/layouts/*"],
      "@variants": ["src/variants"],
      "@schemas": ["schemas"],
      "@types": ["types/index.d.ts"],
      "@utils": ["src/utils"],
    }
  }
}