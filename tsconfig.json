{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@*": ["library/*"],
      "@components/*": ["library/components/*"],
      "@layouts/*": ["library/layouts/*"],
      "@variants": ["library/variants"],
      "@schemas": ["library/schemas"],
      "@utils": ["library/utils"],
      "@stores": ["library/stores"],
      "@assets": ["library/assets"],
      "@data": ["library/data"],
    }
  }
}