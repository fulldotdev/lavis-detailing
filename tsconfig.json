{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@variants": ["src/variants"],
      "@schemas": ["src/schemas"],
      "@utils": ["src/utils"],
    }
  }
}