---
import company from '@data/company.yml'
import { SEO } from 'astro-seo'

interface Props {
  title?: string | null
  description?: string | null
  image?: {
    src: string | null
    alt?: string | null
  }
}

const { title, description, image } = Astro.props
---

<meta
  content="width=device-width, initial-scale=1, viewport-fit=cover"
  name="viewport"
/>
<meta
  name="generator"
  content={Astro.generator}
/>

<SEO
  title={title || company.name || undefined}
  description={description || company.description || undefined}
  openGraph={{
    basic: {
      title: title || company.name || '',
      type: 'website',
      image: image?.src || company.image || '',
    },
    image: {
      url: image?.src || company.image || '',
      alt: image?.alt || 'Logo' + company.name || '',
    },
  }}
/>
