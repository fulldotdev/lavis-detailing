---
import company from '@data/company.yml'
---

{
  company.logo && (
    <a
      href="/"
      class="flex"
    >
      <img
        class="text-primary h-2em block w-auto object-contain"
        src={company.logo}
        alt={'Logo ' + company.company}
        loading="lazy"
        decoding="async"
      />
    </a>
  )
}
